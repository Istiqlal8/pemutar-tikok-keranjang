{
  "manifest_version": 3,
  "name": "TikTok Keranjang",
  "version": "1.3.0",
  "description": "Tampilkan produk keranjang kuning dan putar video TikTok di browser.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.tikwm.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "player.html" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["collect.js", "ui.js"],
      "css": ["ui.css"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["player.html"], "matches": ["https://www.tiktok.com/*"] }
  ]
}
